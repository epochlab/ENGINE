# Documented cppcheck suppressions; each states why the finding is not a defect here. Anything unlisted is fixed, not silenced.

# Fires on every aggregate without a constructor; all are brace-initialised at use, so "= 0" on ~170 members is defensive noise.
uninitMemberVarNoCtor

# HudOverlay and Window members touch no instance state: ImGui and GLFW hold it globally. The type is the seam, deliberately.
functionStatic

# Fires on the universal setter convention, setAperture(float aperture) "shadowing" aperture(); renaming would read worse.
shadowFunction

# resolveTexture takes HdrImage by value and returns the parameter, so it performs zero or one move where a const ref forces a copy.
passedByValue:*/gltf_loader.cpp

# accumulateMean's `sample` is an in/out buffer: the mean is computed in the pass buffer, which makes publish a pointer assignment.
constParameterReference:*/path_trace_driver.cpp

# cppcheck's preprocessor cannot evaluate __has_builtin, which sampler.cpp uses to select an intrinsic. A configuration gap.
syntaxError:*/sampler.cpp

# Applied case by case: nearly every hit also accumulates a second quantity or exits early, which an algorithm would hide.
useStlAlgorithm

# spawnQuiet builds posix_spawn's argv (char* const[]), so the loop must hand out mutable data(); a const ref does not compile.
constVariableReference:*/bench_compare.cpp
